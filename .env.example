# ==============================================================================
# CareerFind India - Environment Variables Template
# Copy this file to .env.local for local development.
# In production, configure these variables in the Vercel Project Settings.
# ==============================================================================

# Public domain URL (used for canonical tags, OpenGraph, and sitemaps)
# In development: http://localhost:3000
# In production: https://careerfind-india.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration
# (Obtained from Supabase Dashboard -> Project Settings -> API)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# You can provide either the publishable key or the legacy anon key:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Service Role Key (ONLY for secure server-side routes; NEVER prefix with NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ------------------------------------------------------------------------------
# Google AdSense Monetization Configuration
# ------------------------------------------------------------------------------
# 1. Your official Google AdSense Publisher ID (format: ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# 2. Master Toggle: Keep 'false' until Google AdSense verifies and approves your site
NEXT_PUBLIC_ADSENSE_ENABLED=false

# 3. Development Wireframe Mode: Set to 'true' to preview reserved layout containers
NEXT_PUBLIC_ADSENSE_SHOW_PLACEHOLDERS=false

# 4. Ad Slot IDs (obtained from Google AdSense Console -> Ads -> By ad unit)
NEXT_PUBLIC_ADSENSE_SLOT_HOMEPAGE_TOP=1234567890
NEXT_PUBLIC_ADSENSE_SLOT_HOMEPAGE_INFEED=2345678901
NEXT_PUBLIC_ADSENSE_SLOT_HOMEPAGE_SIDEBAR=3456789012
NEXT_PUBLIC_ADSENSE_SLOT_JOB_DETAILS=4567890123
NEXT_PUBLIC_ADSENSE_SLOT_BLOG_INARTICLE=5678901234
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER_BANNER=6789012345

# 5. Granular Enable/Disable Toggles for Individual Placements
NEXT_PUBLIC_ADSENSE_ENABLE_HOMEPAGE_TOP=true
NEXT_PUBLIC_ADSENSE_ENABLE_HOMEPAGE_INFEED=true
NEXT_PUBLIC_ADSENSE_ENABLE_HOMEPAGE_SIDEBAR=true
NEXT_PUBLIC_ADSENSE_ENABLE_JOB_DETAILS=true
NEXT_PUBLIC_ADSENSE_ENABLE_BLOG_INARTICLE=true
NEXT_PUBLIC_ADSENSE_ENABLE_FOOTER_BANNER=true
